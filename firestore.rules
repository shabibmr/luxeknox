rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public remote app config (API_BASE_URL, etc.). Write stays locked.
    match /config/app {
      allow get, list: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
