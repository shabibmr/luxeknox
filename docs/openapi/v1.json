{
  "openapi": "3.0.0",
  "paths": {
    "/v1/settings/public": {
      "get": {
        "description": "Returns unauthenticated public gym configuration such as canonical operating timezone and currency.",
        "operationId": "SettingsController_getPublicSettings",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Public gym settings"
          }
        },
        "summary": "Get public gym settings",
        "tags": [
          "Settings"
        ]
      }
    },
    "/v1/settings": {
      "get": {
        "description": "Returns all gym settings key-value pairs. Requires `settings.read` permission (Super Admin / Admin).",
        "operationId": "SettingsController_getAllSettings",
        "parameters": [],
        "responses": {
          "200": {
            "description": "All system settings dictionary"
          },
          "401": {
            "description": "Unauthenticated or missing Bearer token"
          },
          "403": {
            "description": "Forbidden: missing settings.read permission"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get all system settings",
        "tags": [
          "Settings"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "description": "Returns HTTP 200 indicating the Node.js / NestJS process is running without checking database connectivity.",
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Process is healthy and operational",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Process liveness health check",
        "tags": [
          "Health"
        ]
      }
    },
    "/v1/ready": {
      "get": {
        "description": "Pings MySQL using Drizzle / connection pool (SELECT 1). Returns 200 if connected, or 503 if disconnected.",
        "operationId": "HealthController_getReady",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Application and database are ready to serve requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "Database is disconnected or unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponseDto"
                }
              }
            }
          }
        },
        "summary": "Readiness check with database ping",
        "tags": [
          "Health"
        ]
      }
    },
    "/v1/auth/login": {
      "post": {
        "description": "Validates credentials, checks rate limiting, and returns an opaque access token and refresh token pair.",
        "operationId": "AuthController_login",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials or inactive account"
          },
          "429": {
            "description": "Rate limit exceeded for identifier or IP"
          }
        },
        "summary": "Authenticate user with identifier and password",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "description": "Validates refresh token, detects reuse of revoked tokens across family, and returns a new token pair.",
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Token refreshed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, or reused refresh token"
          }
        },
        "summary": "Refresh access token with refresh token rotation",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "description": "Revokes the session corresponding to the provided Bearer access token and invalidates cache.",
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Session revoked successfully"
          },
          "401": {
            "description": "Bearer token missing or malformed"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Revoke active session and logout",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "description": "Returns the authenticated user details, assigned role, resolved permission slug list, and profile stub (null in Module 0).",
        "operationId": "MeController_getMe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current user profile summary with resolved permission slugs"
          },
          "401": {
            "description": "Unauthenticated or invalid session"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get current authenticated user profile and permissions",
        "tags": [
          "Auth"
        ]
      }
    },
    "/v1/exercises": {
      "get": {
        "description": "Browse/search active exercises by muscle, equipment, difficulty (FR-WORK-002).",
        "operationId": "listExercises",
        "parameters": [
          {
            "name": "difficulty_level",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "equipment_needed",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "primary_muscle_group",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Case-insensitive search (FR-API-014).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Default from gym_settings pagination.default_page_size.",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExercisePageResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired session"
          },
          "403": {
            "description": "Forbidden: missing exercises.read permission"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Exercise library",
        "tags": [
          "WORK"
        ]
      },
      "post": {
        "description": "Admin CRUD (FR-WORK-001).",
        "operationId": "createExercise",
        "parameters": [],
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExerciseResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Missing or expired session"
          },
          "403": {
            "description": "Forbidden: missing exercises.create permission"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create an exercise",
        "tags": [
          "WORK"
        ]
      }
    },
    "/v1/exercises/{id}": {
      "get": {
        "description": "Detail includes media URLs (FR-WORK-002).",
        "operationId": "getExercise",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExerciseResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Exercise not found"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Exercise detail",
        "tags": [
          "WORK"
        ]
      },
      "patch": {
        "description": "Partial update. `is_active: false` deactivates — no separate delete endpoint.",
        "operationId": "updateExercise",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExerciseResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "404": {
            "description": "Exercise not found"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Update or deactivate an exercise",
        "tags": [
          "WORK"
        ]
      }
    }
  },
  "info": {
    "title": "LuxeKnox API",
    "description": "LuxeKnox backend spine and core platform services API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "Opaque (gk_at_*)",
        "type": "http",
        "description": "Provide your opaque access token prefixed with gk_at_"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok",
            "description": "Application process status"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-09-16T12:00:00.000Z",
            "description": "Current UTC ISO-8601 timestamp"
          }
        },
        "required": [
          "status",
          "timestamp"
        ]
      },
      "ReadyResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok",
            "enum": [
              "ok",
              "error"
            ],
            "description": "Readiness probe status"
          },
          "database": {
            "type": "string",
            "example": "connected",
            "enum": [
              "connected",
              "disconnected"
            ],
            "description": "MySQL database connectivity status"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-09-16T12:00:00.000Z",
            "description": "Current UTC ISO-8601 timestamp"
          }
        },
        "required": [
          "status",
          "database",
          "timestamp"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "gk_at_xyz789...",
            "description": "Opaque 256-bit access token valid for 30 minutes (1800 seconds)"
          },
          "refreshToken": {
            "type": "string",
            "example": "gk_rt_abc123...",
            "description": "Opaque 256-bit refresh token valid for 30 days (sliding)"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer",
            "enum": [
              "Bearer"
            ],
            "description": "HTTP Authorization header token type"
          },
          "expiresIn": {
            "type": "number",
            "example": 1800,
            "description": "Access token expiration lifespan in seconds (30 minutes)"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn"
        ]
      },
      "ExerciseResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "primary_muscle_group": {
            "type": "string",
            "nullable": true
          },
          "secondary_muscles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "equipment_needed": {
            "type": "string",
            "nullable": true
          },
          "instructions": {
            "type": "string",
            "nullable": true
          },
          "video_url": {
            "type": "string",
            "nullable": true
          },
          "gif_url": {
            "type": "string",
            "nullable": true
          },
          "difficulty_level": {
            "type": "string",
            "nullable": true
          },
          "is_active": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "primary_muscle_group",
          "secondary_muscles",
          "equipment_needed",
          "instructions",
          "video_url",
          "gif_url",
          "difficulty_level",
          "is_active"
        ]
      },
      "ExercisePageMetaDto": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number"
          },
          "offset": {
            "type": "number",
            "nullable": true
          },
          "cursor": {
            "type": "string",
            "nullable": true
          },
          "next_cursor": {
            "type": "string",
            "nullable": true
          },
          "has_more": {
            "type": "boolean"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "limit",
          "offset",
          "cursor",
          "next_cursor",
          "has_more"
        ]
      },
      "ExercisePageResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExerciseResponseDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ExercisePageMetaDto"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      }
    }
  }
}