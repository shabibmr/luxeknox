# Application
NODE_ENV=development
PORT=3000

# Database (MySQL 8.4)
# Connection pool enforces time_zone='+00:00' and transaction isolation READ-COMMITTED
DATABASE_URL=mysql://luxeknox:luxeknox_secret@localhost:3306/luxeknox
DB_HOST=localhost
DB_PORT=3306
# App runtime credentials: DML only. Cannot UPDATE or DELETE audit_logs.
DB_USER=luxeknox
DB_PASSWORD=luxeknox_secret
DB_NAME=luxeknox

# Migration/DDL credentials. Used only by `pnpm db:migrate`, never by the running API.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=root_secret

# Bootstrap Initial Super Admin
BOOTSTRAP_ADMIN_EMAIL=admin@luxeknox.com
BOOTSTRAP_ADMIN_PASSWORD=AdminSecurePassword123!

# Authentication Note:
# LuxeKnox uses opaque tokens (gk_at_ / gk_rt_) with SHA-256 hashes stored in the sessions table.
# No JWT secrets or keys are used or supported.

# Express trust-proxy setting (e.g. `1` or a CIDR). When unset, req.ip is the socket peer
# and a client-supplied X-Forwarded-For header is ignored for login throttling.
# TRUST_PROXY=1

# Bootstrap Super Admin. BOOTSTRAP_ADMIN_PASSWORD is required when NODE_ENV=production.
# Rotating this value after the first seed has no effect — the seed never overwrites an existing password.
