# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL 17)
# Connection pool sets session `timezone` to UTC; TIMESTAMPTZ columns are offset-correct
# regardless (ADR-0009). Isolation is READ COMMITTED (PostgreSQL default).
DATABASE_URL=postgres://luxeknox:luxeknox_secret@localhost:5432/luxeknox
DB_HOST=localhost
DB_PORT=5432
# App runtime credentials: DML only. Cannot UPDATE or DELETE audit_logs.
DB_USER=luxeknox
DB_PASSWORD=luxeknox_secret
DB_NAME=luxeknox

# Migration/DDL credentials. Used only by `pnpm db:migrate`, never by the running API.
# In the local Docker image, POSTGRES_USER (luxeknox) is itself the superuser — there is no
# separate root/postgres account, unlike MySQL's root. On a managed/self-hosted target, point
# this at a dedicated admin role instead of the app's least-privilege user.
DB_ADMIN_USER=luxeknox
DB_ADMIN_PASSWORD=luxeknox_secret

# Bootstrap Initial Super Admin
BOOTSTRAP_ADMIN_EMAIL=admin@luxeknox.com
BOOTSTRAP_ADMIN_PASSWORD=123456

# Authentication Note:
# LuxeKnox uses opaque tokens (gk_at_ / gk_rt_) with SHA-256 hashes stored in the sessions table.
# No JWT secrets or keys are used or supported.

# Express trust-proxy setting (e.g. `1` or a CIDR). When unset, req.ip is the socket peer
# and a client-supplied X-Forwarded-For header is ignored for login throttling.
# TRUST_PROXY=1

# Bootstrap Super Admin. BOOTSTRAP_ADMIN_PASSWORD is required when NODE_ENV=production.
# Re-seeding does not overwrite existing password hashes unless SEED_RESET_PASSWORDS=1.
