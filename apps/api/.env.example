# Application
NODE_ENV=development
PORT=3000

# Database (MySQL 8.4)
# Connection pool enforces time_zone='+00:00' and transaction isolation READ-COMMITTED
DATABASE_URL=mysql://luxeknox:luxeknox_secret@localhost:3306/luxeknox
DB_HOST=localhost
DB_PORT=3306
# App runtime credentials: DML only. Cannot UPDATE or DELETE audit_logs.
DB_USER=luxeknox
DB_PASSWORD=luxeknox_secret
DB_NAME=luxeknox

# Migration/DDL credentials. Used only by `pnpm db:migrate`, never by the running API.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=root_secret

# Bootstrap Initial Super Admin
BOOTSTRAP_ADMIN_EMAIL=admin@luxeknox.com
BOOTSTRAP_ADMIN_PASSWORD=123456

# Authentication Note:
# LuxeKnox uses opaque tokens (gk_at_ / gk_rt_) with SHA-256 hashes stored in the sessions table.
# No JWT secrets or keys are used or supported.

# MEDIA (ADR-0008) — local disk by default; no cloud credentials required for verification.
MEDIA_DRIVER=local
MEDIA_LOCAL_ROOT=.media
MEDIA_SIGNING_SECRET=change-me-media-signing
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:3000
MEDIA_SIGNED_URL_TTL_SECONDS=900
# S3-compatible (optional; not fully wired in V3 — prefer local for now):
# MEDIA_DRIVER=s3
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_ACCESS_KEY=
# MEDIA_S3_SECRET_KEY=
